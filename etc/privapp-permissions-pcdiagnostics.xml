<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged permissions of PcDiagnostics (system_ext priv-app). READ_LOGS and DUMP are
     signature|privileged: the logs page runs logcat and dumpsys with them, and a privileged app gets them only
     when they are listed here. Its other permissions are normal or signature level (INTERNET,
     ACCESS_NETWORK_STATE, ACCESS_WIFI_STATE, NETWORK_SETTINGS) or runtime ones the person grants on the page
     (RECORD_AUDIO, CAMERA), so they are not listed. -->
<permissions>
    <privapp-permissions package="org.lineageos.pcdiagnostics">
        <permission name="android.permission.DUMP" />
        <permission name="android.permission.READ_LOGS" />
    </privapp-permissions>
</permissions>
