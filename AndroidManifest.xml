<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pcdiagnostics">

    <!-- Connectivity tests: name resolution and the captive portal check page. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- SSID and BSSID without turning location on (signature: granted by the platform certificate). -->
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />

    <!-- Settings (system uid) reads the About rows' summaries from HardwareSummaryProvider. -->
    <permission
        android:name="org.lineageos.pcdiagnostics.permission.READ_HARDWARE_SUMMARY"
        android:protectionLevel="signature" />

    <!-- The drawer opens PcTaskManager when it is installed. -->
    <queries>
        <package android:name="org.lineageos.pctaskmanager" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PcDiagnostics">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings > System tile. -->
        <activity-alias
            android:name=".SettingsDiagnosticsActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/app_name" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
        </activity-alias>

        <!-- Settings > Battery tile. -->
        <activity-alias
            android:name=".SettingsBatteryActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/settings_battery_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_battery_summary" />
        </activity-alias>

        <!-- Settings > About rows (CPU, RAM, storage), under the device name. They open the overview,
             where the CPU, memory and storage cards are. -->
        <activity-alias
            android:name=".AboutCpuActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.my_device_info" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="basic_info_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="100" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/about_cpu_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.pcdiagnostics.hardware/cpu" />
        </activity-alias>

        <activity-alias
            android:name=".AboutMemoryActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.my_device_info" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="basic_info_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="110" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/about_memory_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.pcdiagnostics.hardware/memory" />
        </activity-alias>

        <activity-alias
            android:name=".AboutStorageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.my_device_info" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="basic_info_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="120" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/about_storage_title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.pcdiagnostics.hardware/storage" />
        </activity-alias>

        <provider
            android:name=".HardwareSummaryProvider"
            android:authorities="org.lineageos.pcdiagnostics.hardware"
            android:exported="true"
            android:readPermission="org.lineageos.pcdiagnostics.permission.READ_HARDWARE_SUMMARY" />
    </application>
</manifest>
