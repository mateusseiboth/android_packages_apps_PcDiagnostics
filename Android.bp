// PcDiagnostics: hardware checks for the PC (CPU, memory, storage, battery, network, input, audio, camera),
// like ChromeOS Diagnostics.
// The checks, parsers and test runner live in core/ and are tested on the host.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "PcDiagnosticsCore",
    host_supported: true,
    srcs: ["core/src/**/*.kt"],
    sdk_version: "core_current",
}

java_test_host {
    name: "PcDiagnosticsCoreTests",
    srcs: ["core/tests/**/*.kt"],
    static_libs: [
        "PcDiagnosticsCore",
        "junit",
    ],
    test_options: {
        unit_test: true,
    },
}

android_app {
    name: "PcDiagnostics",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "PcDiagnosticsCore",
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.animation_animation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.camera_camera-core",
        "androidx.camera_camera-camera2",
        "androidx.camera_camera-lifecycle",
        "androidx.camera_camera-compose",
        "kotlinx_coroutines_android",
    ],
    optimize: {
        optimize: true,
        shrink_resources: true,
    },
    required: [
        "privapp-permissions-pcdiagnostics.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-pcdiagnostics.xml",
    src: "etc/privapp-permissions-pcdiagnostics.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
